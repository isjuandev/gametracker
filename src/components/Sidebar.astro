---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  {
    name: "Dashboard",
    href: "/",
    exact: true,
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>`,
  },
  {
    name: "Juegos",
    href: "/games",
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="12" x="2" y="6" rx="2"></rect><path d="M12 12h.01"></path><path d="M17 12h.01"></path><path d="M7 12h.01"></path></svg>`,
  },
  {
    name: "Estadísticas",
    href: "/stats",
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V10"></path><path d="M12 20V4"></path><path d="M6 20v-6"></path></svg>`,
  },
  {
    name: "Importar",
    href: "/import",
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>`,
  },
  {
    name: "Configuración",
    href: "/settings",
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle cx="12" cy="12" r="3"></circle></svg>`,
  },
];
---

<aside class="sidebar-container" id="app-sidebar">
  <!-- Brand Header -->
  <div class="sidebar-brand">
    <a href="/" class="brand-link">
      <div class="brand-icon-box">
        <svg
          class="brand-icon"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="6" y1="12" x2="10" y2="12"></line>
          <line x1="8" y1="10" x2="8" y2="14"></line>
          <line x1="15" y1="13" x2="15.01" y2="13"></line>
          <line x1="18" y1="11" x2="18.01" y2="11"></line>
          <rect width="20" height="12" x="2" y="6" rx="6"></rect>
        </svg>
      </div>
      <div class="brand-text">
        <span class="brand-name"
          >Registro de <span class="brand-highlight">Horas</span></span
        >
      </div>
    </a>
  </div>

  <!-- Navigation Menu -->
  <nav class="sidebar-nav">
    <ul class="nav-list">
      {
        navItems.map((item) => {
          const isActive = item.exact
            ? currentPath === item.href
            : currentPath.startsWith(item.href);

          return (
            <li class="nav-item">
              <a
                href={item.href}
                class:list={["nav-link", { active: isActive }]}
              >
                <span class="nav-icon" set:html={item.icon} />
                <span class="nav-label">{item.name}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <!-- Bottom Decorative Cyber / Racing Stripes -->
  <div class="sidebar-footer-decor" aria-hidden="true">
    <div class="cyber-stripe stripe-1"></div>
    <div class="cyber-stripe stripe-2"></div>
    <div class="cyber-stripe stripe-3"></div>
  </div>
</aside>

<style>
  .sidebar-container {
    width: 230px;
    height: 100vh;
    background: #0b0c12;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    flex-shrink: 0;
    z-index: 100;
    user-select: none;
    overflow: hidden;
  }

  .sidebar-brand {
    padding: var(--space-lg) var(--space-lg) var(--space-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .brand-icon-box {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, #e53935, #b71c1c);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    box-shadow: 0 0 14px rgba(229, 57, 53, 0.5);
    flex-shrink: 0;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.02em;
  }

  .brand-highlight {
    color: var(--color-accent);
  }

  /* Navigation */
  .sidebar-nav {
    flex: 1;
    padding: var(--space-md) var(--space-sm);
    overflow-y: auto;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 8px;
    color: #8b8c9e;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all var(--transition-fast);
    border: 1px solid transparent;
  }

  .nav-link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.04);
  }

  .nav-link.active {
    background: rgba(229, 57, 53, 0.12);
    border-color: rgba(229, 57, 53, 0.35);
    color: #ff3344;
    font-weight: 600;
    box-shadow: 0 0 16px rgba(229, 57, 53, 0.15);
  }

  .nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    flex-shrink: 0;
  }

  .nav-label {
    white-space: nowrap;
  }

  /* Bottom Cyber / Racing Stripes Decor */
  .sidebar-footer-decor {
    position: relative;
    height: 70px;
    padding: 0 var(--space-lg) var(--space-md);
    display: flex;
    align-items: flex-end;
    gap: 8px;
    opacity: 0.6;
    pointer-events: none;
  }

  .cyber-stripe {
    height: 28px;
    width: 8px;
    transform: skewX(-24deg);
    border-radius: 2px;
  }

  .stripe-1 {
    background: rgba(229, 57, 53, 0.8);
    box-shadow: 0 0 8px rgba(229, 57, 53, 0.5);
  }

  .stripe-2 {
    background: rgba(229, 57, 53, 0.4);
    height: 20px;
  }

  .stripe-3 {
    background: rgba(229, 57, 53, 0.2);
    height: 14px;
  }

  /* Responsive sidebar drawer for mobile */
  @media (max-width: 900px) {
    .sidebar-container {
      position: fixed;
      left: -240px;
      transition: left 0.3s ease;
      box-shadow: 10px 0 30px rgba(0, 0, 0, 0.8);
    }

    .sidebar-container.open {
      left: 0;
    }
  }
</style>
