---
import type { GameWithStats } from '../types/database';
import { formatTime, STATUS_LABELS } from '../types/database';

interface Props {
  game: GameWithStats;
}

const { game } = Astro.props;

const statusClass = `badge-${game.status}`;
---

<div class="game-case game-card" data-game-id={game.id}>
  <!-- Physical Case Spine (left plastic edge) -->
  <div class="case-spine" aria-hidden="true"></div>

  <!-- Physical Case Plastic Reflex / Glare sheen -->
  <div class="case-glare" aria-hidden="true"></div>

  <!-- Card Main Content / Cover -->
  <div class="case-inner">
    <a href={`/games/${game.id}`} class="case-cover-link" title={`Ver ${game.name}`}>
      {game.cover_url ? (
        <div class="case-artwork-wrap">
          <!-- Ambient blurred backdrop for images that aren't exact vertical ratio -->
          <div
            class="case-ambient-backdrop"
            style={`background-image: url('${game.cover_url}')`}
            aria-hidden="true"
          />
          <!-- The main game artwork: sharp, centered, never distorted or cropped -->
          <img
            src={game.cover_url}
            alt={game.name}
            class="case-artwork-img"
            loading="lazy"
          />
        </div>
      ) : (
        <div class="case-placeholder">
          <span class="placeholder-icon">🎮</span>
          <span class="placeholder-name">{game.name}</span>
        </div>
      )}

      <!-- Top Header: Platform Case Bar & Status Badge -->
      <div class="case-header">
        <div class="case-platform-pill">
          <span class="platform-dot"></span>
          <span>GAME</span>
        </div>
        <div class={`badge ${statusClass} case-badge`}>
          {STATUS_LABELS[game.status]}
        </div>
      </div>

      <!-- Bottom: Dark Glass Game Information Overlay -->
      <div class="case-info-overlay">
        <h3 class="case-title" title={game.name}>{game.name}</h3>

        <div class="case-stats-row">
          <div class="case-time">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>{game.total_seconds > 0 ? formatTime(game.total_seconds) : '0h 00m'}</span>
          </div>
          <span class="case-stats-dot">·</span>
          <div class="case-sessions">
            {game.entries_count} {game.entries_count === 1 ? 'sesión' : 'sesiones'}
          </div>
        </div>
      </div>
    </a>

    <!-- Action Toolbar (Ver, Edit, Delete) -->
    <div class="case-toolbar">
      <a href={`/games/${game.id}`} class="btn-case-action btn-case-view">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
        <span>Detalles</span>
      </a>

      <button
        class="btn-case-icon edit-game-btn"
        data-game-id={game.id}
        data-game-name={game.name}
        data-game-cover={game.cover_url || ''}
        data-game-status={game.status}
        title="Editar juego"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
        </svg>
      </button>

      <button
        class="btn-case-icon btn-case-delete delete-game-btn"
        data-game-id={game.id}
        data-game-name={game.name}
        title="Eliminar juego"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  /* Physical Game Case Container (PS5 / Xbox style) */
  .game-case {
    position: relative;
    display: flex;
    flex-direction: column;
    aspect-ratio: 1 / 1.48;
    background: #0f1118;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow:
      0 6px 16px rgba(0, 0, 0, 0.45),
      0 1px 2px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    overflow: hidden;
    transition: transform 0.28s cubic-bezier(0.2, 0, 0.2, 1),
                box-shadow 0.28s cubic-bezier(0.2, 0, 0.2, 1),
                border-color 0.28s ease;
    user-select: none;
  }

  .game-case:hover {
    transform: translateY(-5px) scale(1.02);
    border-color: rgba(229, 57, 53, 0.45);
    box-shadow:
      0 16px 32px rgba(0, 0, 0, 0.65),
      0 0 20px rgba(229, 57, 53, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  /* Physical spine effect on left edge */
  .case-spine {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 5px;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0.22) 0%,
      rgba(255, 255, 255, 0.05) 50%,
      rgba(0, 0, 0, 0.4) 100%
    );
    z-index: 5;
    pointer-events: none;
  }

  /* Plastic case reflex / glare sheen across the cover */
  .case-glare {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      rgba(255, 255, 255, 0.09) 0%,
      rgba(255, 255, 255, 0.03) 25%,
      transparent 55%
    );
    pointer-events: none;
    z-index: 4;
    transition: opacity 0.3s ease;
  }

  .game-case:hover .case-glare {
    opacity: 0.8;
  }

  .case-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .case-cover-link {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
  }

  /* Artwork & Ambient Backdrop */
  .case-artwork-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #08090d;
  }

  /* Ambient blurred backdrop: fills vertical space with game colors so images never have empty cutoffs */
  .case-ambient-backdrop {
    position: absolute;
    inset: -20px;
    background-size: cover;
    background-position: center;
    filter: blur(22px) brightness(0.55);
    opacity: 0.85;
    transform: scale(1.2);
  }

  /* Main artwork: sharp, centered, never distorted or cropped */
  .case-artwork-img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 1;
    transition: transform 0.35s cubic-bezier(0.2, 0, 0.2, 1);
  }

  .game-case:hover .case-artwork-img {
    transform: scale(1.04);
  }

  .case-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: linear-gradient(135deg, #161822, #10121a);
    color: var(--color-text-muted);
  }

  .placeholder-icon {
    font-size: 2.5rem;
  }

  .placeholder-name {
    font-size: 0.8125rem;
    font-weight: 600;
    text-align: center;
    padding: 0 1rem;
    color: var(--color-text-secondary);
  }

  /* Case Header (Top bar: console pill + status) */
  .case-header {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 10px;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.75) 0%, transparent 100%);
  }

  .case-platform-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 7px;
    background: rgba(0, 0, 0, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #e0e0f0;
    backdrop-filter: blur(6px);
  }

  .platform-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 6px var(--color-accent);
  }

  .case-badge {
    font-size: 0.6875rem;
    padding: 2px 7px;
    border-radius: 4px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(6px);
  }

  /* Information Overlay at the bottom of the cover */
  .case-info-overlay {
    position: relative;
    z-index: 3;
    margin-top: auto;
    padding: 28px 10px 8px 10px;
    background: linear-gradient(
      to top,
      rgba(8, 9, 14, 0.98) 0%,
      rgba(8, 9, 14, 0.82) 65%,
      rgba(8, 9, 14, 0.4) 85%,
      transparent 100%
    );
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .case-title {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.25;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
    transition: color 0.2s ease;
  }

  .case-cover-link:hover .case-title {
    color: var(--color-accent-hover);
  }

  .case-stats-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
  }

  .case-time {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .case-stats-dot {
    color: rgba(255, 255, 255, 0.3);
    font-weight: bold;
  }

  .case-sessions {
    color: var(--color-text-muted);
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  /* Case Action Toolbar */
  .case-toolbar {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 8px 8px 8px;
    background: #08090e;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .btn-case-action {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 5px 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 5px;
    color: var(--color-text-primary);
    font-size: 0.6875rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-case-action:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
    box-shadow: 0 2px 8px rgba(229, 57, 53, 0.4);
  }

  .btn-case-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 5px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-case-icon:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
    color: var(--color-text-primary);
  }

  .btn-case-delete:hover {
    background: rgba(255, 82, 82, 0.12);
    border-color: rgba(255, 82, 82, 0.3);
    color: var(--color-danger);
  }
</style>
