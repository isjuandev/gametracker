          <div class="metric-top">
            <div class="metric-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <span class="metric-label" id="metric-label-period">TIEMPO EN LA SEMANA</span>
          </div>
          <div class="metric-value accent-glow" id="metric-total-time">0h 00m</div>
          <div class="metric-subtitle" id="metric-period-label">tiempo acumulado</div>
          <div class="corner-slash" aria-hidden="true"></div>
        </div>

        <!-- Card 2: Top Game -->
        <div class="metric-card">
          <div class="metric-top">
            <div class="metric-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
                <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                <path d="M4 22h16"></path>
                <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
                <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
                <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
              </svg>
            </div>
            <span class="metric-label">JUEGO MÁS JUGADO</span>
          </div>
          <div class="metric-value" id="metric-topgame-name">—</div>
          <div class="metric-subtitle" id="metric-topgame-time">0h 00m registradas</div>
          <div class="corner-slash" aria-hidden="true"></div>
        </div>

        <!-- Card 3: Active Games -->
        <div class="metric-card">
          <div class="metric-top">
            <div class="metric-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="6" y1="12" x2="10" y2="12"></line>
                <line x1="8" y1="10" x2="8" y2="14"></line>
                <line x1="15" y1="13" x2="15.01" y2="13"></line>
                <line x1="18" y1="11" x2="18.01" y2="11"></line>
                <rect width="20" height="12" x="2" y="6" rx="6"></rect>
              </svg>
            </div>
            <span class="metric-label">JUEGOS ACTIVOS</span>
          </div>
          <div class="metric-value" id="metric-games-count">0</div>
          <div class="metric-subtitle">títulos en el período</div>
          <div class="corner-slash" aria-hidden="true"></div>
        </div>

        <!-- Card 4: Sessions & Active Days -->
        <div class="metric-card">
          <div class="metric-top">
            <div class="metric-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </div>
            <span class="metric-label">SESIONES</span>
          </div>
          <div class="metric-value" id="metric-sessions-count">0</div>
          <div class="metric-subtitle" id="metric-days-subtext">0 días con juego</div>
          <div class="corner-slash" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <!-- Period Featured Game Banner -->
    <div class="spotlight-card" id="period-spotlight-card">
      <!-- Injected dynamically -->
    </div>

    <!-- Activity Calendar / Distribution Section -->
    <section class="section distribution-section">
      <div class="section-header-block">
        <div class="section-title-wrap">
          <h2 class="section-title-mark" id="dist-section-title">Actividad del Período</h2>
        </div>
        <p class="section-subtitle" id="dist-section-subtitle">Días y horas dedicadas durante el período seleccionado</p>
      </div>

      <div class="chart-card card">
        <div id="chart-bars-container" class="chart-bars-container">
          <!-- Rendered dynamically -->
        </div>
      </div>
    </section>

    <!-- Games Breakdown Section -->
    <section class="section games-breakdown-section">
      <div class="section-header-block">
        <div class="section-title-wrap">
          <h2 class="section-title-mark" id="breakdown-section-title">Horas Jugadas por Juego</h2>
          <span class="count-pill" id="breakdown-games-pill">0 juegos</span>
        </div>
        <p class="section-subtitle">
          Tiempo acumulado, porcentaje de dedicación y sesiones de cada juego en el período seleccionado
        </p>
      </div>

      <div id="games-breakdown-list" class="games-breakdown-list">
        <!-- Rendered dynamically -->
      </div>
    </section>
  </div>

  <!-- ALL TIME VIEW (Tab 3: Global) -->
  <div id="all-time-view-wrapper" class="all-time-view-wrapper" style="display: none;">
    <!-- 4-Card Global Metrics Row -->
    <section class="period-metrics-section">
      <div class="stats-metrics-row">
        <div class="metric-card highlighted">
          <div class="metric-top">
            <div class="metric-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <span class="metric-label">TIEMPO TOTAL HISTÓRICO</span>
          </div>
          <div class="metric-value accent-glow">{formatTimeShort(totalSeconds)}</div>
          <div class="metric-subtitle">toda tu historia</div>
          <div class="corner-slash" aria-hidden="true"></div>
        </div>

        <div class="metric-card">
          <div class="metric-top">
            <div class="metric-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <span class="metric-label">PROMEDIO POR SESIÓN</span>
          </div>
          <div class="metric-value">{avgSecondsPerSession > 0 ? formatTimeShort(avgSecondsPerSession) : '0m'}</div>
          <div class="metric-subtitle">por cada partida</div>
          <div class="corner-slash" aria-hidden="true"></div>
        </div>

        <div class="metric-card">
          <div class="metric-top">
            <div class="metric-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="6" y1="12" x2="10" y2="12"></line>
                <line x1="8" y1="10" x2="8" y2="14"></line>
                <line x1="15" y1="13" x2="15.01" y2="13"></line>
                <line x1="18" y1="11" x2="18.01" y2="11"></line>
                <rect width="20" height="12" x="2" y="6" rx="6"></rect>
              </svg>
            </div>
            <span class="metric-label">TOTAL JUEGOS</span>
          </div>
          <div class="metric-value">{allGames.length}</div>
          <div class="metric-subtitle">en tu biblioteca</div>
          <div class="corner-slash" aria-hidden="true"></div>
        </div>

        <div class="metric-card">
          <div class="metric-top">
            <div class="metric-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>
            <span class="metric-label">SESIONES TOTALES</span>
          </div>
          <div class="metric-value">{totalSessions}</div>
          <div class="metric-subtitle">{completedCount} juegos completados</div>
          <div class="corner-slash" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <!-- Global Top Game Spotlight -->
    {topGame && (
      <div class="spotlight-card">
        <div class="spotlight-spine" aria-hidden="true"></div>
        <div class="spotlight-badge">🏆 JUEGO MÁS JUGADO DE SIEMPRE</div>
        <div class="spotlight-body">
          <div class="spotlight-art-wrap">
            {topGame.cover_url ? (
              <img src={topGame.cover_url} alt={topGame.name} class="spotlight-cover" />
            ) : (
              <div class="spotlight-placeholder">🎮</div>
            )}
          </div>
          <div class="spotlight-info">
            <div class="spotlight-header-row">
              <h2 class="spotlight-title">{topGame.name}</h2>
              <span class={`badge badge-${topGame.status}`}>{STATUS_LABELS[topGame.status]}</span>
            </div>
            <div class="spotlight-time">{formatTime(topGame.total_seconds)}</div>
            <div class="spotlight-meta">
              <span class="spotlight-meta-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                {topGame.entries_count} sesiones registradas
              </span>
            </div>
            <a href={`/games/${topGame.id}`} class="btn btn-secondary btn-sm spotlight-btn">
              Ver ficha del juego →
            </a>
          </div>
        </div>
      </div>
    )}

    <!-- Ranking Histórico Completo -->
    <section class="section animate-slide-up" style="margin-top: var(--space-2xl);">
      <div class="section-header-block">
        <div class="section-title-wrap">
          <h2 class="section-title-mark">Ranking Histórico Completo</h2>
          <span class="count-pill">{gamesWithStats.length} títulos</span>
        </div>
        <p class="section-subtitle">Tiempo acumulado de toda tu historia de juego por título</p>
      </div>

      <div class="ranking-card card">
        {gamesWithStats.map((game, index) => {
          const percent = Math.max(4, Math.round((game.total_seconds / (maxPlaytime || 1)) * 100));
          const rankClass = index === 0 ? 'rank-gold' : index === 1 ? 'rank-silver' : index === 2 ? 'rank-bronze' : 'rank-normal';
          return (
            <div class="ranking-row">
              <div class={`ranking-index ${rankClass}`}>
                {index === 0 ? '🏆 #1' : `#${index + 1}`}
              </div>
              <div class="ranking-art">
                {game.cover_url ? (
                  <img src={game.cover_url} alt={game.name} class="ranking-thumb" />
                ) : (
                  <div class="ranking-placeholder">🎮</div>
                )}
              </div>
              <div class="ranking-details">
                <div class="ranking-header">
                  <div class="ranking-title-wrap">
                    <a href={`/games/${game.id}`} class="ranking-name">{game.name}</a>
                    <span class={`badge badge-${game.status} badge-compact`}>{STATUS_LABELS[game.status]}</span>
                  </div>
                  <span class="ranking-time">{formatTime(game.total_seconds)}</span>
                </div>
                <div class="ranking-bar-bg">
                  <div class="ranking-bar-fill" style={`width: ${percent}%;`}></div>
                </div>
                <div class="ranking-footer">
                  <span>{game.entries_count} {game.entries_count === 1 ? 'sesión' : 'sesiones'}</span>
                  <span>{percent}% del máximo</span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>
  </div>

  <!-- Raw Payload embedded for client reactivity -->
  <script id="stats-data" type="application/json" set:html={JSON.stringify(statsPayload)} />
  </div>
</Layout>

<script>
  interface GameStat {
    game_id: string;
    name: string;
    cover_url: string | null;
    status: string;
    total_seconds: number;
    formatted_time: string;
    formatted_short: string;
    entries_count: number;
    days_count: number;
    percentage: number;
  }

  interface DayStat {
    date: string;
    day_name?: string;
    day_short: string;
    day_num: number;
    day_of_week?: number;
    seconds: number;
    formatted: string;
    percent: number;
  }

  interface PeriodRecord {
    id: string;
    label: string;
    isCurrent: boolean;
    total_seconds: number;
    formatted_time: string;
    formatted_short: string;
    entries_count: number;
    active_days_count: number;
    days_in_month?: number;
    first_day_offset?: number;
    games_count: number;
    top_game: GameStat | null;
    daily_distribution: DayStat[];
    games: GameStat[];
  }

  interface Payload {
    weeks: PeriodRecord[];
    months: PeriodRecord[];
    todayStr?: string;
  }

  const rawDataEl = document.getElementById('stats-data');
  if (rawDataEl) {
    const data: Payload = JSON.parse(rawDataEl.textContent || '{}');

    const tabBtnWeek = document.getElementById('tab-btn-week') as HTMLButtonElement;
    const tabBtnMonth = document.getElementById('tab-btn-month') as HTMLButtonElement;
    const tabBtnAll = document.getElementById('tab-btn-all') as HTMLButtonElement;
    const periodViewWrapper = document.getElementById('period-view-wrapper') as HTMLElement;
    const allTimeViewWrapper = document.getElementById('all-time-view-wrapper') as HTMLElement;

    const periodSelect = document.getElementById('period-select') as HTMLSelectElement;
    const btnPrev = document.getElementById('btn-period-prev') as HTMLButtonElement;
    const btnNext = document.getElementById('btn-period-next') as HTMLButtonElement;
    const btnCurrent = document.getElementById('btn-period-current') as HTMLButtonElement;
    const currentBtnLabel = document.getElementById('current-period-btn-label') as HTMLElement;

    // Metrics elements
    const metricLabelPeriod = document.getElementById('metric-label-period') as HTMLElement;
    const metricTotalTime = document.getElementById('metric-total-time') as HTMLElement;
    const metricPeriodLabel = document.getElementById('metric-period-label') as HTMLElement;
    const metricTopGameName = document.getElementById('metric-topgame-name') as HTMLElement;
    const metricTopGameTime = document.getElementById('metric-topgame-time') as HTMLElement;
    const metricGamesCount = document.getElementById('metric-games-count') as HTMLElement;
    const metricSessionsCount = document.getElementById('metric-sessions-count') as HTMLElement;
    const metricDaysSubtext = document.getElementById('metric-days-subtext') as HTMLElement;

    const spotlightCard = document.getElementById('period-spotlight-card') as HTMLElement;

    // Chart elements
    const distTitle = document.getElementById('dist-section-title') as HTMLElement;
    const distSubtitle = document.getElementById('dist-section-subtitle') as HTMLElement;
    const chartBarsContainer = document.getElementById('chart-bars-container') as HTMLElement;

    // Breakdown elements
    const breakdownTitle = document.getElementById('breakdown-section-title') as HTMLElement;
    const breakdownPill = document.getElementById('breakdown-games-pill') as HTMLElement;
    const gamesListContainer = document.getElementById('games-breakdown-list') as HTMLElement;

    let currentMode: 'week' | 'month' | 'all' = 'week';
    let selectedWeekId = data.weeks.length > 0 ? data.weeks[0].id : '';
    let selectedMonthId = data.months.length > 0 ? data.months[0].id : '';

    const STATUS_MAP: Record<string, { label: string; class: string }> = {
      playing: { label: 'Jugando', class: 'badge-playing' },
      completed: { label: 'Completado', class: 'badge-completed' },
      paused: { label: 'Pausado', class: 'badge-paused' },
      dropped: { label: 'Abandonado', class: 'badge-dropped' },
    };

    function updatePeriodDropdown() {
      periodSelect.innerHTML = '';
      const list = currentMode === 'week' ? data.weeks : data.months;
      const activeId = currentMode === 'week' ? selectedWeekId : selectedMonthId;

      list.forEach((item) => {
        const opt = document.createElement('option');
        opt.value = item.id;
        const currentTag = item.isCurrent ? (currentMode === 'week' ? ' (Semana actual)' : ' (Mes actual)') : '';
        const timeTag = item.total_seconds > 0 ? ` — ${item.formatted_short}` : ' — 0m';
        opt.textContent = `${item.label}${currentTag}${timeTag}`;
        if (item.id === activeId) {
          opt.selected = true;
        }
        periodSelect.appendChild(opt);
      });

      updateNavButtonsState();
    }

    function updateNavButtonsState() {
      const list = currentMode === 'week' ? data.weeks : data.months;
      const activeId = currentMode === 'week' ? selectedWeekId : selectedMonthId;
      const currentIndex = list.findIndex((item) => item.id === activeId);

      btnPrev.disabled = currentIndex >= list.length - 1;
      btnNext.disabled = currentIndex <= 0;

      if (currentMode === 'week') {
        currentBtnLabel.textContent = 'Ir a Semana Actual';
        btnCurrent.style.display = activeId === (data.weeks[0]?.id || '') ? 'none' : 'inline-flex';
      } else {
        currentBtnLabel.textContent = 'Ir a Mes Actual';
        btnCurrent.style.display = activeId === (data.months[0]?.id || '') ? 'none' : 'inline-flex';
      }
    }

    function renderActivePeriod() {
      if (currentMode === 'all') return;

      const list = currentMode === 'week' ? data.weeks : data.months;
      const activeId = currentMode === 'week' ? selectedWeekId : selectedMonthId;
      const period = list.find((item) => item.id === activeId) || list[0];

      if (!period) return;

      // 1. Metrics row
      metricLabelPeriod.textContent = currentMode === 'week' ? 'TIEMPO EN LA SEMANA' : 'TIEMPO EN EL MES';
      metricTotalTime.textContent = period.formatted_short || '0m';
      metricPeriodLabel.textContent = currentMode === 'week' ? 'total esta semana' : 'total este mes';

      if (period.top_game) {
        metricTopGameName.textContent = period.top_game.name;
        metricTopGameName.title = period.top_game.name;
        metricTopGameTime.textContent = `${period.top_game.formatted_short} (${period.top_game.percentage}%)`;
      } else {
        metricTopGameName.textContent = '—';
        metricTopGameTime.textContent = 'Sin partidas registradas';
      }

      metricGamesCount.textContent = period.games_count.toString();
      metricSessionsCount.textContent = period.entries_count.toString();
      metricDaysSubtext.textContent = currentMode === 'week'
        ? `${period.active_days_count} de 7 días activos`
        : `${period.active_days_count} días con juego`;

      // 2. Spotlight Card
      if (period.top_game) {
        spotlightCard.style.display = 'block';
        const topG = period.top_game;
        const statusObj = STATUS_MAP[topG.status] || { label: 'Jugando', class: 'badge-playing' };
        spotlightCard.innerHTML = `
          <div class="spotlight-spine" aria-hidden="true"></div>
          <div class="spotlight-badge">${currentMode === 'week' ? '🏆 JUEGO DESTACADO DE LA SEMANA' : '🏆 JUEGO DESTACADO DEL MES'}</div>
          <div class="spotlight-body">
            <div class="spotlight-art-wrap">
              ${topG.cover_url
                ? `<img src="${topG.cover_url}" alt="${topG.name}" class="spotlight-cover" loading="lazy" />`
                : `<div class="spotlight-placeholder">🎮</div>`
              }
            </div>
            <div class="spotlight-info">
              <div class="spotlight-header-row">
                <h2 class="spotlight-title">${topG.name}</h2>
                <span class="badge ${statusObj.class}">${statusObj.label}</span>
              </div>
              <div class="spotlight-time">${topG.formatted_time}</div>
              <div class="spotlight-meta">
                <span class="spotlight-meta-pill highlight-pill">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                    <polyline points="17 6 23 6 23 12"></polyline>
                  </svg>
                  <strong>${topG.percentage}%</strong> del tiempo total
                </span>
                <span class="spotlight-meta-pill">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <strong>${topG.entries_count}</strong> ${topG.entries_count === 1 ? 'sesión' : 'sesiones'}
                </span>
                <span class="spotlight-meta-pill">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="18" y2="10"></line>
                  </svg>
                  <strong>${topG.days_count}</strong> ${topG.days_count === 1 ? 'día activo' : 'días activos'}
                </span>
              </div>
              <a href="/games/${topG.game_id}" class="btn btn-secondary btn-sm spotlight-btn">
                Ver ficha del juego →
              </a>
            </div>
          </div>
        `;
      } else {
        spotlightCard.style.display = 'block';
        spotlightCard.innerHTML = `
          <div class="spotlight-spine" aria-hidden="true"></div>
          <div class="spotlight-badge">${currentMode === 'week' ? '📅 RESUMEN SEMANAL' : '🗓️ RESUMEN MENSUAL'}</div>
          <div class="spotlight-body spotlight-empty-body">
            <div class="spotlight-placeholder">🎮</div>
            <div class="spotlight-info">
              <h2 class="spotlight-title">Sin actividad de juego</h2>
              <p class="spotlight-subtitle">No se registraron partidas durante ${period.label}</p>
            </div>
          </div>
        `;
      }

      // 3. Distribution Chart / Calendar
      if (currentMode === 'week') {
        distTitle.textContent = `Distribución Semanal (${period.label})`;
        distSubtitle.textContent = 'Horas y sesiones registradas de lunes a domingo';
      } else {
        distTitle.textContent = `Calendario de Actividad (${period.label})`;
        distSubtitle.textContent = 'Desglose diario de horas jugadas a lo largo del mes';
      }

      renderDistributionChart(period, currentMode);

      // 4. Games Breakdown List
      breakdownTitle.textContent = currentMode === 'week' ? 'Juegos Jugados en la Semana' : 'Juegos Jugados en el Mes';
      breakdownPill.textContent = `${period.games.length} ${period.games.length === 1 ? 'juego' : 'juegos'}`;

      renderGamesBreakdown(period.games, period.total_seconds);
      updateNavButtonsState();
    }

    function renderDistributionChart(period: PeriodRecord, mode: 'week' | 'month') {
      chartBarsContainer.innerHTML = '';
      if (!period.daily_distribution || period.daily_distribution.length === 0) {
        chartBarsContainer.innerHTML = '<div class="chart-empty">Sin datos de actividad</div>';
        return;
      }

      const today = data.todayStr || new Date().toISOString().slice(0, 10);

      if (mode === 'month') {
        const days = period.daily_distribution;
        const totalDays = period.days_in_month || days.length;
        const activeDays = period.active_days_count;
        const firstDayOffset = period.first_day_offset ?? 0;

        let maxDay: DayStat | null = null;
        for (const d of days) {
          if (d.seconds > 0 && (!maxDay || d.seconds > maxDay.seconds)) {
            maxDay = d;
          }
        }

        const avgActiveSecs = activeDays > 0 ? Math.round(period.total_seconds / activeDays) : 0;
        let avgActiveFormatted = '0m';
        if (avgActiveSecs > 0) {
          const h = Math.floor(avgActiveSecs / 3600);
          const m = Math.round((avgActiveSecs % 3600) / 60);
          avgActiveFormatted = h > 0 ? `${h}h ${m}m` : `${m}m`;
        }

        let padHtml = '';
        for (let i = 0; i < firstDayOffset; i++) {
          padHtml += `<div class="cal-pad-cell" aria-hidden="true"></div>`;
        }

        const dayCellsHtml = days.map((day) => {
          const isToday = day.date === today;
          const isWeekend = day.day_of_week === 0 || day.day_of_week === 6;
          const hasPlay = day.seconds > 0;
          const progressWidth = Math.max(12, Math.min(100, day.percent));

          return `
            <div class="cal-day-cell ${hasPlay ? 'cal-has-play' : 'cal-is-idle'} ${isToday ? 'cal-is-today' : ''} ${isWeekend ? 'cal-is-weekend' : ''}" data-date="${day.date}" title="${day.date}: ${hasPlay ? day.formatted : 'Sin partidas'}">
              <div class="cal-cell-header">
                <div class="cal-cell-day-meta">
                  <span class="cal-cell-num">${day.day_num}</span>
                  <span class="cal-cell-dayname">${day.day_short}</span>
                </div>
                ${isToday ? `<span class="cal-today-pill">HOY</span>` : ''}
              </div>
              <div class="cal-cell-content">
                ${hasPlay ? `
                  <div class="cal-time-pill">${day.formatted}</div>
                  <div class="cal-cell-bar">
                    <div class="cal-cell-bar-fill" style="width: ${progressWidth}%;"></div>
                  </div>
                ` : `
                  <span class="cal-cell-empty">—</span>
                `}
              </div>
            </div>
          `;
        }).join('');

        chartBarsContainer.innerHTML = `
          <div class="month-calendar-view">
            <div class="cal-summary-bar">
              <div class="cal-summary-item">
                <span class="cal-summary-label">Días con Juego</span>
                <span class="cal-summary-value"><strong class="accent">${activeDays}</strong> de ${totalDays} días</span>
              </div>
              <div class="cal-summary-item">
                <span class="cal-summary-label">Tiempo del Mes</span>
                <span class="cal-summary-value font-display">${period.formatted_short || '0m'}</span>
              </div>
              <div class="cal-summary-item">
                <span class="cal-summary-label">Promedio / Día Activo</span>
                <span class="cal-summary-value">${avgActiveFormatted}</span>
              </div>
              ${maxDay ? `
                <div class="cal-summary-item">
                  <span class="cal-summary-label">Día Más Activo</span>
                  <span class="cal-summary-value"><strong class="accent">${maxDay.formatted}</strong> (${maxDay.day_short} ${maxDay.day_num})</span>
                </div>
              ` : ''}
            </div>

            <div class="cal-grid-wrapper">
              <div class="cal-weekdays-header">
                <div class="cal-weekday-col">LUN</div>
                <div class="cal-weekday-col">MAR</div>
                <div class="cal-weekday-col">MIÉ</div>
                <div class="cal-weekday-col">JUE</div>
                <div class="cal-weekday-col">VIE</div>
                <div class="cal-weekday-col cal-weekend">SÁB</div>
                <div class="cal-weekday-col cal-weekend">DOM</div>
              </div>
              <div class="cal-days-grid">
                ${padHtml}
                ${dayCellsHtml}
              </div>
            </div>
          </div>
        `;
      } else {
        // Week View
        const days = period.daily_distribution;
        const activeDays = period.active_days_count;

        let maxDay: DayStat | null = null;
        for (const d of days) {
          if (d.seconds > 0 && (!maxDay || d.seconds > maxDay.seconds)) {
            maxDay = d;
          }
        }

        const dayCardsHtml = days.map((day) => {
          const isToday = day.date === today;
          const hasPlay = day.seconds > 0;
          const barHeight = hasPlay ? Math.max(14, day.percent) : 3;

          return `
            <div class="week-day-card ${hasPlay ? 'has-play' : 'is-idle'} ${isToday ? 'is-today' : ''}" title="${day.date}: ${hasPlay ? day.formatted : 'Sin partidas'}">
              <div class="week-day-header">
                <span class="week-day-name">${day.day_short}</span>
                <span class="week-day-num">${day.day_num}</span>
                ${isToday ? `<span class="cal-today-pill">HOY</span>` : ''}
              </div>
              <div class="week-bar-container">
                <div class="week-bar-fill" style="height: ${barHeight}%;"></div>
              </div>
              <div class="week-day-time ${hasPlay ? 'accent' : 'muted'}">
                ${hasPlay ? day.formatted : '0m'}
              </div>
            </div>
          `;
        }).join('');

        chartBarsContainer.innerHTML = `
          <div class="week-calendar-view">
            <div class="cal-summary-bar">
              <div class="cal-summary-item">
                <span class="cal-summary-label">Días Activos</span>
                <span class="cal-summary-value"><strong class="accent">${activeDays}</strong> de 7 días</span>
              </div>
              <div class="cal-summary-item">
                <span class="cal-summary-label">Total en la Semana</span>
                <span class="cal-summary-value font-display">${period.formatted_short || '0m'}</span>
              </div>
              ${maxDay ? `
                <div class="cal-summary-item">
                  <span class="cal-summary-label">Día Más Jugado</span>
                  <span class="cal-summary-value"><strong class="accent">${maxDay.formatted}</strong> (${maxDay.day_name || maxDay.day_short} ${maxDay.day_num})</span>
                </div>
              ` : ''}
            </div>

            <div class="week-days-grid">
              ${dayCardsHtml}
            </div>
          </div>
        `;
      }
    }

    function renderGamesBreakdown(games: GameStat[], totalPeriodSeconds: number) {
      gamesListContainer.innerHTML = '';

      if (!games || games.length === 0) {
        gamesListContainer.innerHTML = `
          <div class="empty-state card">
            <div class="empty-state-icon">🎮</div>
            <div class="empty-state-title">No hay partidas registradas en este período</div>
            <p class="empty-state-text">Selecciona otra semana o mes desde la barra de navegación para ver tu histórico.</p>
          </div>
        `;
        return;
      }

      games.forEach((game, index) => {
        const statusObj = STATUS_MAP[game.status] || { label: 'Jugando', class: 'badge-playing' };
        const percentOfMax = games[0] && games[0].total_seconds > 0 ? Math.max(6, Math.round((game.total_seconds / games[0].total_seconds) * 100)) : 100;
        const rankClass = index === 0 ? 'rank-gold' : index === 1 ? 'rank-silver' : index === 2 ? 'rank-bronze' : 'rank-normal';
        const rankBadge = index === 0 ? '🏆 #1' : index === 1 ? '🥈 #2' : index === 2 ? '🥉 #3' : `#${index + 1}`;

        const row = document.createElement('div');
        row.className = 'game-breakdown-row card';

        row.innerHTML = `
          <div class="breakdown-left">
            <div class="breakdown-rank ${rankClass}">${rankBadge}</div>
            <a href="/games/${game.game_id}" class="breakdown-thumb-link" title="Ver ${game.name}">
              ${game.cover_url
                ? `<img src="${game.cover_url}" alt="${game.name}" class="breakdown-thumb" loading="lazy" />`
                : `<div class="breakdown-thumb-placeholder">🎮</div>`
              }
            </a>
            <div class="breakdown-info">
              <div class="breakdown-header-row">
                <a href="/games/${game.game_id}" class="breakdown-game-title">${game.name}</a>
                <span class="badge ${statusObj.class} badge-compact">${statusObj.label}</span>
              </div>
              <div class="breakdown-meta-row">
                <span class="meta-tag">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  ${game.entries_count} ${game.entries_count === 1 ? 'sesión' : 'sesiones'}
                </span>
                <span class="meta-tag">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="18" y2="10"></line>
                  </svg>
                  ${game.days_count} ${game.days_count === 1 ? 'día activo' : 'días activos'}
                </span>
              </div>
            </div>
          </div>

          <div class="breakdown-right">
            <div class="breakdown-time-row">
              <span class="breakdown-time-value">${game.formatted_time}</span>
              <span class="breakdown-share-badge">${game.percentage}% del período</span>
            </div>
            <div class="breakdown-bar-bg">
              <div class="breakdown-bar-fill" style="width: ${percentOfMax}%;"></div>
            </div>
          </div>
        `;

        gamesListContainer.appendChild(row);
      });
    }

    function setMode(mode: 'week' | 'month' | 'all') {
      currentMode = mode;

      tabBtnWeek.classList.toggle('active', mode === 'week');
      tabBtnMonth.classList.toggle('active', mode === 'month');
      tabBtnAll.classList.toggle('active', mode === 'all');

      if (mode === 'all') {
        periodViewWrapper.style.display = 'none';
        allTimeViewWrapper.style.display = 'block';
      } else {
        periodViewWrapper.style.display = 'block';
        allTimeViewWrapper.style.display = 'none';
        updatePeriodDropdown();
        renderActivePeriod();
      }
    }

    tabBtnWeek.addEventListener('click', () => setMode('week'));
    tabBtnMonth.addEventListener('click', () => setMode('month'));
    tabBtnAll.addEventListener('click', () => setMode('all'));

    periodSelect.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      if (currentMode === 'week') {
        selectedWeekId = val;
      } else {
        selectedMonthId = val;
      }
      renderActivePeriod();
    });

    btnPrev.addEventListener('click', () => {
      const list = currentMode === 'week' ? data.weeks : data.months;
      const activeId = currentMode === 'week' ? selectedWeekId : selectedMonthId;
      const currentIndex = list.findIndex((item) => item.id === activeId);
      if (currentIndex < list.length - 1) {
        const nextPeriod = list[currentIndex + 1];
        if (currentMode === 'week') {
          selectedWeekId = nextPeriod.id;
        } else {
          selectedMonthId = nextPeriod.id;
        }
        periodSelect.value = nextPeriod.id;
        renderActivePeriod();
      }
    });

    btnNext.addEventListener('click', () => {
      const list = currentMode === 'week' ? data.weeks : data.months;
      const activeId = currentMode === 'week' ? selectedWeekId : selectedMonthId;
      const currentIndex = list.findIndex((item) => item.id === activeId);
      if (currentIndex > 0) {
        const prevPeriod = list[currentIndex - 1];
        if (currentMode === 'week') {
          selectedWeekId = prevPeriod.id;
        } else {
          selectedMonthId = prevPeriod.id;
        }
        periodSelect.value = prevPeriod.id;
        renderActivePeriod();
      }
    });

    btnCurrent.addEventListener('click', () => {
      if (currentMode === 'week' && data.weeks.length > 0) {
        selectedWeekId = data.weeks[0].id;
        periodSelect.value = selectedWeekId;
        renderActivePeriod();
      } else if (currentMode === 'month' && data.months.length > 0) {
        selectedMonthId = data.months[0].id;
        periodSelect.value = selectedMonthId;
        renderActivePeriod();
      }
    });

    setMode('month');
  }
</script>

