---
import Layout from '../layouts/Layout.astro';
import StatsCard from '../components/StatsCard.astro';
import GameCard from '../components/GameCard.astro';
import { supabase } from '../lib/supabase';
import { formatTime } from '../types/database';
import type { GameWithStats } from '../types/database';

// Fetch games
const { data: games, error: gamesError } = await supabase
  .from('games')
  .select('*');

// Fetch all time entries
const { data: allEntries, error: entriesError } = await supabase
  .from('time_entries')
  .select('game_id, total_seconds, played_at');

// Calculate aggregated stats
const totalsMap = new Map<string, { total_seconds: number; entries_count: number; last_played_at: string | null }>();
let totalSecondsAllTime = 0;
let totalSecondsToday = 0;
let totalSecondsWeek = 0;
let totalSecondsMonth = 0;

const now = new Date();
const todayStr = now.toISOString().split('T')[0];
const weekAgo = new Date(now);
weekAgo.setDate(weekAgo.getDate() - 7);
const weekAgoStr = weekAgo.toISOString().split('T')[0];
const monthStart = new Date(now.getFullYear(), now.getMonth(), 1).toISOString().split('T')[0];

for (const entry of allEntries || []) {
  const current = totalsMap.get(entry.game_id) || { total_seconds: 0, entries_count: 0, last_played_at: null };
  current.total_seconds += entry.total_seconds;
  current.entries_count += 1;
  if (!current.last_played_at || entry.played_at > current.last_played_at) {
    current.last_played_at = entry.played_at;
  }
  totalsMap.set(entry.game_id, current);

  totalSecondsAllTime += entry.total_seconds;

  if (entry.played_at === todayStr) {
    totalSecondsToday += entry.total_seconds;
  }
  if (entry.played_at >= weekAgoStr) {
    totalSecondsWeek += entry.total_seconds;
  }
  if (entry.played_at >= monthStart) {
    totalSecondsMonth += entry.total_seconds;
  }
}

const gamesWithStats: GameWithStats[] = (games || []).map((game) => {
  const stats = totalsMap.get(game.id) || { total_seconds: 0, entries_count: 0, last_played_at: null };
  return { ...game, ...stats };
});

// Sort by most recently played date (descending)
gamesWithStats.sort((a, b) => {
  const dateA = a.last_played_at || '';
  const dateB = b.last_played_at || '';
  if (dateA !== dateB) {
    return dateB.localeCompare(dateA);
  }
  return (b.updated_at || '').localeCompare(a.updated_at || '');
});

const recentGames = gamesWithStats.slice(0, 6);
const totalGames = gamesWithStats.length;
---

<Layout title="Dashboard">
  <!-- Resumen de Juego Section Header -->
  <div class="section-header-block animate-fade-in">
    <div class="section-title-wrap">
      <h1 class="section-title-mark">Resumen de Juego</h1>
    </div>
    <p class="section-subtitle">Tu tiempo, tus partidas, tu historia.</p>
  </div>

  <!-- 5-Card Metrics Row -->
  <section class="animate-slide-up" style="margin-top: var(--space-md);">
    <div class="stats-metrics-row stagger-children">
      <StatsCard
        iconType="games"
        label="TOTAL JUEGOS"
        value={totalGames.toString()}
        subtitle="en tu biblioteca"
      />
      <StatsCard
        iconType="today"
        label="HOY"
        value={totalSecondsToday > 0 ? formatTime(totalSecondsToday) : '0m'}
        subtitle={totalSecondsToday > 0 ? 'tiempo registrado' : 'sin jugar aún'}
      />
      <StatsCard
        iconType="week"
        label="ESTA SEMANA"
        value={totalSecondsWeek > 0 ? formatTime(totalSecondsWeek) : '0m'}
        subtitle="tiempo total"
      />
      <StatsCard
        iconType="month"
        label="ESTE MES"
        value={totalSecondsMonth > 0 ? formatTime(totalSecondsMonth) : '0m'}
        subtitle="tiempo total"
      />
      <StatsCard
        iconType="total"
        label="TIEMPO TOTAL"
        value={totalSecondsAllTime > 0 ? formatTime(totalSecondsAllTime) : '0m'}
        subtitle="toda tu historia"
        isHighlighted={true}
      />
    </div>
  </section>

  <!-- Juegos Recientes Section -->
  <section class="section animate-slide-up">
    <div class="section-header-block">
      <div class="section-title-wrap">
        <h2 class="section-title-mark">Juegos Recientes</h2>
        {totalGames > 0 && (
          <a href="/games" class="btn btn-secondary btn-sm">Ver todos →</a>
        )}
      </div>
    </div>

    {recentGames.length > 0 ? (
      <div class="games-grid stagger-children">
        {recentGames.map((game) => (
          <GameCard game={game} />
        ))}
      </div>
    ) : (
      <div class="empty-state card">
        <div class="empty-state-icon">🎮</div>
        <div class="empty-state-title">No hay juegos registrados</div>
        <p class="empty-state-text">Agrega tu primer juego para comenzar a registrar tu tiempo</p>
        <a href="/games" class="btn btn-primary btn-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Agregar Juego
        </a>
      </div>
    )}
  </section>
</Layout>

<script>
  // Handle delete and global search on Dashboard
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const deleteBtn = target.closest('.delete-game-btn') as HTMLElement;
    if (deleteBtn) {
      const gameId = deleteBtn.dataset.gameId;
      const gameName = deleteBtn.dataset.gameName;
      if (confirm(`¿Eliminar "${gameName}"? Se borrarán todos sus registros de tiempo.`)) {
        fetch(`/api/games/${gameId}`, { method: 'DELETE' })
          .then((res) => {
            if (res.ok) {
              window.location.reload();
            } else {
              alert('Error al eliminar el juego');
            }
          })
          .catch(() => alert('Error de conexión'));
      }
    }
  });

  // Global search filtering
  window.addEventListener('global-game-search', ((e: CustomEvent) => {
    const query = e.detail?.query || '';
    const cards = document.querySelectorAll('.game-card');
    cards.forEach((card) => {
      const cardEl = card as HTMLElement;
      const titleEl = card.querySelector('.case-title');
      const title = titleEl?.textContent?.toLowerCase() || '';
      cardEl.style.display = !query || title.includes(query) ? '' : 'none';
    });
  }) as EventListener);
</script>
