---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import { formatTime, STATUS_LABELS, getLocalDateStr } from '../../types/database';
import type { Game, TimeEntry } from '../../types/database';

const { id } = Astro.params;

// Fetch game
const { data: game, error: gameError } = await supabase
  .from('games')
  .select('*')
  .eq('id', id)
  .single();

if (gameError || !game) {
  return Astro.redirect('/games');
}

// Fetch time entries
const { data: entries } = await supabase
  .from('time_entries')
  .select('*')
  .eq('game_id', id)
  .order('played_at', { ascending: false });

const allEntries = (entries || []) as TimeEntry[];

// Calculate stats
const totalSeconds = allEntries.reduce((sum, e) => sum + e.total_seconds, 0);

const now = new Date();
const todayStr = getLocalDateStr(now);
const weekAgo = new Date(now);
weekAgo.setDate(weekAgo.getDate() - 7);
const weekAgoStr = getLocalDateStr(weekAgo);
const monthStart = getLocalDateStr(new Date(now.getFullYear(), now.getMonth(), 1));

const todaySeconds = allEntries
  .filter(e => e.played_at === todayStr)
  .reduce((sum, e) => sum + e.total_seconds, 0);

const weekSeconds = allEntries
  .filter(e => e.played_at >= weekAgoStr)
  .reduce((sum, e) => sum + e.total_seconds, 0);

const monthSeconds = allEntries
  .filter(e => e.played_at >= monthStart)
  .reduce((sum, e) => sum + e.total_seconds, 0);

const typedGame = game as Game;
const statusClass = `badge-${typedGame.status}`;

// Group entries by date
const entriesByDate = new Map<string, TimeEntry[]>();
for (const entry of allEntries) {
  const dateEntries = entriesByDate.get(entry.played_at) || [];
  dateEntries.push(entry);
  entriesByDate.set(entry.played_at, dateEntries);
}

function formatDate(dateStr: string): string {
  const date = new Date(dateStr + 'T12:00:00');
  return date.toLocaleDateString('es-ES', {
    weekday: 'short',
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
}
---

<Layout title={typedGame.name}>
  <div style="position: relative; z-index: 1;">
    <!-- Back link -->
    <a href="/games" class="back-link animate-fade-in">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      Volver a Juegos
    </a>

    <!-- Game Header -->
    <div class="game-detail-header animate-slide-up">
      <div class="game-detail-cover">
        {typedGame.cover_url ? (
          <img src={typedGame.cover_url} alt={typedGame.name} class="game-detail-img" />
        ) : (
          <div class="game-detail-placeholder">🎮</div>
        )}
      </div>
      <div class="game-detail-info">
        <div class="game-detail-meta">
          <span class={`badge ${statusClass}`}>{STATUS_LABELS[typedGame.status]}</span>
        </div>
        <h1 class="game-detail-name">{typedGame.name}</h1>
        <div class="game-detail-total">
          <span class="game-detail-total-value">{totalSeconds > 0 ? formatTime(totalSeconds) : '0m'}</span>
          <span class="game-detail-total-label">tiempo total</span>
        </div>
        <div class="game-detail-quick-stats">
          <div class="quick-stat">
            <span class="quick-stat-value">{todaySeconds > 0 ? formatTime(todaySeconds) : '—'}</span>
            <span class="quick-stat-label">Hoy</span>
          </div>
          <div class="quick-stat-divider"></div>
          <div class="quick-stat">
            <span class="quick-stat-value">{weekSeconds > 0 ? formatTime(weekSeconds) : '—'}</span>
            <span class="quick-stat-label">Semana</span>
          </div>
          <div class="quick-stat-divider"></div>
          <div class="quick-stat">
            <span class="quick-stat-value">{monthSeconds > 0 ? formatTime(monthSeconds) : '—'}</span>
            <span class="quick-stat-label">Mes</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Add Time Form -->
    <section class="section animate-slide-up" style="animation-delay: 100ms;">
      <div class="section-header">
        <h2 class="section-title">⏱️ Registrar Tiempo</h2>
      </div>

      <form id="time-form" class="time-form card">
        <div class="time-form-row">
          <div class="time-form-fields">
            <div class="form-group time-hms-group">
              <label class="form-label">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                Tiempo Jugado
              </label>
              <div class="time-hms-container">
                <div class="time-hms-box">
                  <input
                    type="text"
                    id="time-hours"
                    class="form-input time-hms-input"
                    placeholder="00"
                    maxlength="3"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    autocomplete="off"
                  />
                  <span class="time-hms-label">Horas</span>
                </div>
                <span class="time-hms-colon">:</span>
                <div class="time-hms-box">
                  <input
                    type="text"
                    id="time-minutes"
                    class="form-input time-hms-input"
                    placeholder="00"
                    maxlength="2"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    autocomplete="off"
                  />
                  <span class="time-hms-label">Minutos</span>
                </div>
                <span class="time-hms-colon">:</span>
                <div class="time-hms-box">
                  <input
                    type="text"
                    id="time-seconds"
                    class="form-input time-hms-input"
                    placeholder="00"
                    maxlength="2"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    autocomplete="off"
                  />
                  <span class="time-hms-label">Segundos</span>
                </div>
              </div>
            </div>

            <div class="form-group date-field-group">
              <label class="form-label" for="time-date">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;">
                  <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                Fecha
              </label>
              <input
                type="date"
                id="time-date"
                class="form-input"
                value={todayStr}
                max={todayStr}
                required
              />
            </div>

            <div class="form-group note-field-group">
              <label class="form-label" for="time-note">Nota (opcional)</label>
              <input
                type="text"
                id="time-note"
                class="form-input"
                placeholder="Ej: Completé el capítulo 3"
              />
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-lg time-form-submit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Agregar
          </button>
        </div>
      </form>
    </section>

    <!-- Time Entries History -->
    <section class="section animate-slide-up" style="animation-delay: 200ms;">
      <div class="section-header">
        <h2 class="section-title">📋 Historial de Sesiones</h2>
        <span style="font-size: 0.875rem; color: var(--color-text-muted);">
          {allEntries.length} {allEntries.length === 1 ? 'registro' : 'registros'}
        </span>
      </div>

      {allEntries.length > 0 ? (
        <div class="entries-list">
          {Array.from(entriesByDate.entries()).map(([date, dateEntries]) => {
            const dayTotal = dateEntries.reduce((sum, e) => sum + e.total_seconds, 0);
            return (
              <div class="date-group">
                <div class="date-group-header">
                  <span class="date-group-date">{formatDate(date)}</span>
                  <span class="date-group-total">{formatTime(dayTotal)}</span>
                </div>
                {dateEntries.map((entry) => (
                  <div class="entry-row" data-entry-id={entry.id}>
                    <div class="entry-time">{formatTime(entry.total_seconds)}</div>
                    <div class="entry-detail">
                      {entry.hours > 0 && <span>{entry.hours}h</span>}
                      {entry.minutes > 0 && <span>{entry.minutes}m</span>}
                      {entry.seconds > 0 && <span>{entry.seconds}s</span>}
                    </div>
                    {entry.note && <div class="entry-note">{entry.note}</div>}
                    <button class="btn btn-ghost btn-icon delete-entry-btn" data-entry-id={entry.id} title="Eliminar registro">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      </svg>
                    </button>
                  </div>
                ))}
              </div>
            );
          })}
        </div>
      ) : (
        <div class="empty-state card">
          <div class="empty-state-icon">⏱️</div>
          <div class="empty-state-title">Sin registros de tiempo</div>
          <p class="empty-state-text">Usa el formulario de arriba para agregar tu primera sesión</p>
        </div>
      )}
    </section>
  </div>
</Layout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: var(--space-lg);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  /* Game Detail Header */
  .game-detail-header {
    display: flex;
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
    padding: var(--space-xl);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    position: relative;
    overflow: hidden;
  }

  .game-detail-header::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), transparent);
  }

  .game-detail-cover {
    width: 180px;
    height: 240px;
    flex-shrink: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 2px solid var(--color-border);
  }

  .game-detail-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .game-detail-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    background: var(--color-bg-elevated);
    opacity: 0.5;
  }

  .game-detail-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-md);
  }

  .game-detail-meta {
    display: flex;
    gap: var(--space-sm);
  }

  .game-detail-name {
    font-size: 2rem;
    margin: 0;
  }

  .game-detail-total {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .game-detail-total-value {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
  }

  .game-detail-total-label {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .game-detail-quick-stats {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-sm);
  }

  .quick-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .quick-stat-value {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .quick-stat-label {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .quick-stat-divider {
    width: 1px;
    height: 30px;
    background: var(--color-border);
  }

  /* Time Form */
  .time-form {
    padding: var(--space-xl);
  }

  .time-form-row {
    display: flex;
    align-items: flex-end;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .time-form-fields {
    display: flex;
    gap: var(--space-md);
    flex: 1;
    min-width: 320px;
    flex-wrap: wrap;
  }

  .time-hms-group {
    flex: 0 0 auto;
  }

  .time-hms-container {
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }

  .time-hms-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .time-hms-input {
    width: 60px;
    height: 42px;
    padding: 0.4rem 0.25rem;
    text-align: center;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .time-hms-input::placeholder {
    color: var(--color-text-muted);
    opacity: 0.45;
  }

  .time-hms-colon {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-muted);
    line-height: 42px;
    user-select: none;
  }

  .time-hms-label {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .date-field-group {
    flex: 0 0 180px;
    min-width: 160px;
  }

  .note-field-group {
    flex: 1 1 200px;
    min-width: 180px;
  }

  .time-form-submit {
    flex-shrink: 0;
    align-self: flex-end;
  }

  /* Date groups */
  .date-group {
    margin-bottom: var(--space-md);
  }

  .date-group-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-sm);
    margin-bottom: 2px;
  }

  .date-group-date {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: capitalize;
  }

  .date-group-total {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .entry-detail {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    display: flex;
    gap: var(--space-xs);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .game-detail-header {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: var(--space-lg);
    }

    .game-detail-cover {
      width: 140px;
      height: 190px;
    }

    .game-detail-name {
      font-size: 1.5rem;
    }

    .game-detail-total-value {
      font-size: 2rem;
    }

    .game-detail-total {
      justify-content: center;
    }

    .game-detail-quick-stats {
      justify-content: center;
    }

    .game-detail-meta {
      justify-content: center;
    }

    .time-form-row {
      flex-direction: column;
      align-items: stretch;
    }

    .time-form-fields {
      flex-direction: column;
      min-width: 0;
    }

    .time-hms-group {
      width: 100%;
    }

    .time-hms-container {
      justify-content: center;
      width: 100%;
    }

    .time-hms-input {
      width: 68px;
      height: 44px;
      font-size: 1.2rem;
    }

    .date-field-group,
    .note-field-group {
      flex: 1 1 100%;
      width: 100%;
    }

    .time-form-submit {
      align-self: stretch;
    }

    .entry-row {
      grid-template-columns: auto 1fr auto;
    }
  }
</style>

<script define:vars={{ gameId: id }}>
  function getLocalDateStr() {
    const d = new Date();
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  const form = document.getElementById('time-form');
  const hoursInput = document.getElementById('time-hours');
  const minutesInput = document.getElementById('time-minutes');
  const secondsInput = document.getElementById('time-seconds');
  const dateInput = document.getElementById('time-date');

  // Initialize date with local today and block future dates
  if (dateInput) {
    const today = getLocalDateStr();
    dateInput.value = today;
    dateInput.max = today;

    dateInput.addEventListener('change', () => {
      const currentToday = getLocalDateStr();
      if (dateInput.value > currentToday) {
        showToast('No se permiten fechas futuras', 'error');
        dateInput.value = currentToday;
      }
    });
  }

  // Smooth numeric typing and auto-advancing between HMS inputs
  function setupHmsInput(input, maxLen, nextInput, prevInput) {
    if (!input) return;

    input.addEventListener('input', (e) => {
      let val = input.value.replace(/[^0-9]/g, '');
      if (val.length > maxLen) val = val.slice(0, maxLen);
      input.value = val;

      if (val.length >= maxLen && nextInput) {
        nextInput.focus();
        nextInput.select();
      }
    });

    input.addEventListener('keydown', (e) => {
      if ((e.key === ':' || e.key === 'Enter') && nextInput) {
        e.preventDefault();
        nextInput.focus();
        nextInput.select();
      } else if (e.key === 'Backspace' && input.value === '' && prevInput) {
        prevInput.focus();
      }
    });

    input.addEventListener('blur', () => {
      if (input.value && input.value.length === 1 && input !== hoursInput) {
        input.value = input.value.padStart(2, '0');
      }
    });
  }

  setupHmsInput(hoursInput, 3, minutesInput, null);
  setupHmsInput(minutesInput, 2, secondsInput, hoursInput);
  setupHmsInput(secondsInput, 2, null, minutesInput);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    let hours = parseInt(hoursInput?.value || '0', 10);
    let minutes = parseInt(minutesInput?.value || '0', 10);
    let seconds = parseInt(secondsInput?.value || '0', 10);

    if (isNaN(hours)) hours = 0;
    if (isNaN(minutes)) minutes = 0;
    if (isNaN(seconds)) seconds = 0;

    // Normalize if seconds or minutes exceed 59
    if (seconds >= 60) {
      minutes += Math.floor(seconds / 60);
      seconds = seconds % 60;
    }
    if (minutes >= 60) {
      hours += Math.floor(minutes / 60);
      minutes = minutes % 60;
    }

    if (hours === 0 && minutes === 0 && seconds === 0) {
      showToast('El tiempo debe ser mayor a 0', 'error');
      hoursInput?.focus();
      return;
    }

    const today = getLocalDateStr();
    const played_at = dateInput ? dateInput.value : today;

    if (!played_at) {
      showToast('Selecciona una fecha', 'error');
      return;
    }

    if (played_at > today) {
      showToast('No se permiten fechas futuras', 'error');
      if (dateInput) dateInput.value = today;
      return;
    }

    const note = (document.getElementById('time-note')?.value || '').trim();

    try {
      const res = await fetch('/api/time-entries', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          game_id: gameId,
          hours,
          minutes,
          seconds,
          played_at,
          note,
        }),
      });

      if (res.ok) {
        showToast('Tiempo registrado', 'success');
        setTimeout(() => window.location.reload(), 500);
      } else {
        const data = await res.json();
        showToast(data.error || 'Error al registrar', 'error');
      }
    } catch {
      showToast('Error de conexión', 'error');
    }
  });

  // Delete entry
  document.addEventListener('click', async (e) => {
    const deleteBtn = e.target.closest('.delete-entry-btn');
    if (deleteBtn) {
      if (confirm('¿Eliminar este registro de tiempo?')) {
        const entryId = deleteBtn.dataset.entryId;
        try {
          const res = await fetch(`/api/time-entries/${entryId}`, { method: 'DELETE' });
          if (res.ok) {
            showToast('Registro eliminado', 'success');
            setTimeout(() => window.location.reload(), 500);
          } else {
            showToast('Error al eliminar', 'error');
          }
        } catch {
          showToast('Error de conexión', 'error');
        }
      }
    }
  });

  function showToast(message, type) {
    const container = document.getElementById('toast-container');
    if (!container) return;
    const toast = document.createElement('div');
    toast.className = `toast toast-${type}`;
    toast.textContent = type === 'success' ? `✓ ${message}` : `✕ ${message}`;
    container.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
  }
</script>
